---
layout: "layouts/base.njk"
permalink: "/art.html"
title: "Art — Mark Radomski"
description: "Selected paintings, drawings, sculpture and experimental work by Mark Radomski."
nav: "art"
ogTitle: "Art — Mark Radomski"
ogDescription: "Selected paintings, drawings, sculpture and experimental work by Mark Radomski."
ogUrl: "https://markradomski.github.io/art.html"
ogType: "website"
canonical: "https://markradomski.github.io/art.html"
favicon: true
---

    <main class="container">
      <div class="row flex-column">
        <div class="page-header">
       <!--   <h1 class="page-title">Art</h1>
          <h2 class="page-subtitle">
            Selected paintings, drawings, sculpture and experimental work.
          </h2> -->
        </div>

        <div class="page-content">
          <div class="art-gallery" id="art-gallery">
            {% for item in artwork %}
            <figure
              class="art-item"
              data-aspect="{{ item.width }}/{{ item.height }}"
            >
              <a
                class="art-link"
                href="{{ item.src }}"
                data-index="{{ item.index }}"
                data-title="{{ item.title }}"
                data-meta="{{ item.metaLine }}"
              >
                <img
                  src="{{ item.src }}"
                  alt="{{ item.alt }}"
                  width="{{ item.width }}"
                  height="{{ item.height }}"
                  style="aspect-ratio: {{ item.width }} / {{ item.height }}"
                  loading="lazy"
                />
              </a>
              <figcaption>
                <p class="art-title">{{ item.title }}</p>
                {% if item.metaLine %}
                <p class="art-meta">{{ item.metaLine }}</p>
                {% endif %}
              </figcaption>
            </figure>
            {% endfor %}
          </div>
          {% if artwork.length == 0 %}
          <p class="art-empty-state" id="art-empty-state">
            Artwork is on its way&mdash;this gallery is wired up and ready
            for images.
          </p>
          {% endif %}
        </div>
      </div>
    </main>
    <!-- content container -->

    <dialog class="art-viewer" id="art-viewer" aria-label="Artwork viewer">
      <button type="button" class="art-viewer-close" aria-label="Close">
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
      <div class="art-viewer-stage">
        <button
          type="button"
          class="art-viewer-prev"
          aria-label="Previous artwork"
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15 6 9 12 15 18"></polyline>
          </svg>
        </button>
        <img src="" alt="" />
        <button
          type="button"
          class="art-viewer-next"
          aria-label="Next artwork"
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9 6 15 12 9 18"></polyline>
          </svg>
        </button>
      </div>
      <figcaption>
        <p class="art-viewer-title"></p>
        <p class="art-viewer-meta"></p>
      </figcaption>
    </dialog>

    <script src="js/art-layout.js"></script>
    <script src="js/art-gallery.js"></script>
  
